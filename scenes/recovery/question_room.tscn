[node name="Label" type="Label" parent="CenterContainer/QuestionsHolder/VBoxDescription/DescriptionContainer" unique_id=913392130]
custom_minimum_size = Vector2(850, 0)
layout_mode = 2
size_flags_horizontal = 4
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_constants/line_spacing = 15
theme_override_fonts/font = SubResource("FontVariation_1d4n0")
theme_override_font_sizes/font_size = 28
text = "El Archivo Mental es el espacio donde tu conocimiento se convierte en poder. Antes de cada combate, serás evaluado con preguntas sobre los síntomas y las conductas protectoras asociadas a la sustancia que enfrenta tu familiar. Cada respuesta correcta fortalece tu arsenal: si aciertas una pregunta de ataque, ganas proyectiles que generan el doble de daño sobre los enemigos; si aciertas una de defensa, puedes obtener un escudo que reduce el tiempo de los efectos negativos que te causan los enemigos, o una barrera que te protege completamente del daño durante un tiempo. Pero cuidado: equivocarte tiene consecuencias. Las respuestas incorrectas te quitan recursos del mismo tipo. Lo que sabes determina con qué llegas al combate."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

